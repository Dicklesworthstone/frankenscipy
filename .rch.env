FSCI_REQUIRE_SCIPY_ORACLE=1
# The allowlist is EXHAUSTIVE: a variable not named here does not reach the worker, and
# nothing warns when one is dropped. Every `FSCI_SPECIAL_*` knob below used to be silently
# discarded, so an A/B selected by one of them ran the harness's compiled-in defaults twice
# and compared a binary against itself while printing a plausible spread (frankenscipy-xdr2c).
# Arms are now switched in-process rather than by env, but these still steer WHICH cases and
# how many rounds a remote run does, so they have to survive the boundary.
RCH_ENV_ALLOWLIST=CARGO_TARGET_DIR,FSCI_REQUIRE_SCIPY_ORACLE,FSCI_SPECIAL_OPS,FSCI_SPECIAL_ROUNDS,FSCI_SPECIAL_N,FSCI_SPECIAL_XMIN,FSCI_SPECIAL_XMAX,FSCI_SPECIAL_PROBE,FSCI_SPECIAL_REPS
