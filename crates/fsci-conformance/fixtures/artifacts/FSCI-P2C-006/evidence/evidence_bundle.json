        ],
        "mitigation": "Domain validation in Hardened mode. Strict mode NaN propagation matches SciPy behavior."
      },
      {
        "category": "bessel_rational_approximation",
        "description": "J0/J1 use rational polynomial approximation (Numerical Recipes). Accuracy is ~1e-8 near x=0 due to coefficient precision limits.",
        "affected_operations": [
          "j0",
          "j1",
          "jn"
        ],
        "mitigation": "Tolerances set to 1e-8 for bessel boundary checks. Higher-precision coefficients can be substituted."
      },
      {
        "category": "erfinv_domain",
        "description": "erfinv is only defined on (-1, 1). Values at ±1 produce ±Inf, values outside produce NaN in Strict mode.",
        "affected_operations": [
          "erfinv",
          "erfcinv"
        ],
        "mitigation": "Hardened mode rejects out-of-domain inputs. E2E tests cover boundary and out-of-domain cases."
      },
      {
        "category": "gammainc_convergence",
        "description": "Incomplete gamma uses series/continued fraction expansion. Convergence can be slow for large a or x.",
        "affected_operations": [
          "gammainc",
          "gammaincc"
        ],
        "mitigation": "Complement identity P+Q=1 verified in parity gates. Series truncation monitored by iteration count."
      }
    ]
