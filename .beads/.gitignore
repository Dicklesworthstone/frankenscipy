# Database
*.db
*.db-journal
*.db-shm
*.db-wal
# Per-machine sqlite namespace sidecars — same disposable class as *.db itself
*.db-fsqlite-ns-*
# ...including the ones br leaves behind after a schema migration vacuum, whose
# names carry a run id between the db name and the suffix.
*-fsqlite-ns-gate
*-fsqlite-ns-use

# Lock files
*.lock
.write.lock

# Temporary
last-touched
*.tmp

# Local history backups
.br_history/
.br_recovery/
recovery_*/
*.bad_*

# Sync state (local-only, per-machine)
.sync.lock
sync_base.jsonl
config.yaml
metadata.json

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock
sync-state.json

# Worktree redirect file
redirect

# bv (beads viewer) lock file
.bv.lock
*.db-wal*
*.vacuum-wal-cert*
*.fsqlite-migration-state
